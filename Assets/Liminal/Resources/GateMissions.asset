  m_Name: GateMissions
  m_EditorClassIdentifier: Assembly-CSharp::AcRoguelike.Liminal.GateMissionCatalog
  missions:
  - id: liminal_campaign
    code: G-01
    title: "\uC5F0\uC18D \uC18C\uD0D5"
    destinationId: liminal
    destinationName: "\uACBD\uACC4 \uACF5\uAC04"
    briefing: "\uAD6C\uC5ED\uC744 \uC5F0\uB2EC\uC544 \uB3CC\uD30C\uD558\uBA70 \uC99D\uAC15\uC744
      \uD655\uBCF4\uD574. \uB9C8\uC9C0\uB9C9 \uAD6C\uC5ED\uC5D0\uB294 \uBCF4\uC2A4\uAC00
      \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5B4."
    difficulty: 2
    difficultyName: "\uBCF4\uD1B5"
    healthMultiplier: 1
    enemyGimmicks: 0
    gimmickName: "\uCD94\uAC00 \uBCC0\uC774 \uC5C6\uC74C"
    gimmickDescription: "\uC801\uC758 \uAE30\uBCF8 \uACF5\uACA9 \uD328\uD134\uC774
      \uC720\uC9C0\uB3FC. \uD6C4\uBC18 \uAD6C\uC5ED\uC5D0\uB294 \uB354 \uAC15\uD55C
      \uC801\uC774 \uB098\uD0C0\uB098."
    objective: "\uC804 \uAD6C\uC5ED \uC815\uB9AC \xB7 \uCD5C\uC885 \uBCF4\uC2A4 \uACA9\uD30C
      \xB7 \uCD9C\uAD6C \uB3C4\uB2EC"
    stages:
    - {fileID: 11400000, guid: 51d5223c44a4b984093d7d4a6adbaca2, type: 2}
    - {fileID: 11400000, guid: e06536c00f468e34890011d47175118c, type: 2}
    - {fileID: 11400000, guid: 535da8dd6544a3a40b101bf3640826bb, type: 2}
    - {fileID: 11400000, guid: 42001b78a990a314b81f0520c4df7769, type: 2}
  - id: forest_survey
    code: G-02
    title: "\uACBD\uB85C \uC815\uCC30"
    destinationId: forest
    destinationName: "\uB2EC\uBE5B \uACE0\uBAA9\uC758 \uC232"
    briefing: "\uBE44\uAD50\uC801 \uC548\uC815\uC801\uC778 \uC2E0\uD638\uC57C. \uACBD\uB85C\uB97C
      \uC870\uC0AC\uD558\uACE0 \uADC0\uD658 \uC9C0\uC810\uC744 \uD655\uBCF4\uD574."
    difficulty: 1
    difficultyName: "\uC26C\uC6C0"
    healthMultiplier: 1
    enemyGimmicks: 0
    gimmickName: "\uCD94\uAC00 \uBCC0\uC774 \uC5C6\uC74C"
    gimmickDescription: "\uC801\uC758 \uCCB4\uB825\uACFC \uACF5\uACA9\uC740 \uAE30\uBCF8
      \uC218\uCE58 \uADF8\uB300\uB85C\uC57C."
    objective: "\uBAA8\uB4E0 \uC804\uD22C\uBC29 \uC815\uB9AC \xB7 \uCD9C\uAD6C \uB3C4\uB2EC"
    stages:
    - {fileID: 11400000, guid: cbd8b2bd2257f5149adde130d9911ca5, type: 2}
  - id: ruins_clearance
    code: G-04
    title: "\uC800\uD56D\uCCB4 \uC18C\uD0D5"
    destinationId: ruins
    destinationName: "\uBA78\uB9DD\uD55C \uC9C0\uAD6C"
    briefing: "\uC801\uC758 \uBC29\uC5B4 \uBC18\uC751\uC774 \uAC15\uD654\uB410\uC5B4.
      \uAE34 \uAD50\uC804\uC5D0 \uB300\uBE44\uD574."
    difficulty: 2
    difficultyName: "\uBCF4\uD1B5"
    healthMultiplier: 1.25
    enemyGimmicks: 1
    gimmickName: "\uAC15\uD654\uC7A5\uAC11 \xB7 \uD3ED\uD48D\uC758 \uAD70\uC8FC"
    gimmickDescription: "\uC801\uC774 \uBC1B\uB294 \uD53C\uD574 25% \uAC10\uC18C.
      \uC804\uAE30 \uD0C4\uB9C9 \xB7 \uC21C\uC11C\uB300\uB85C \uAE68\uC5B4\uB098\uB294
      \uC804\uC7C1 \uAE30\uACC4 \xB7 3\uC5F0\uBC1C \uB099\uD558 \uBBF8\uC0AC\uC77C.
      \uC608\uACE0\uC640 \uD0C4\uB9C9 \uC0AC\uC774 \uBE48\uD2C8\uC744 \uBCF4\uACE0
      \uD53C\uD558\uB77C."
    objective: "\uC138 \uC804\uD22C \uAD6C\uC5ED \uB3CC\uD30C \xB7 \uD3ED\uD48D\uC758
      \uAD70\uC8FC \uACA9\uD30C \xB7 \uCD9C\uAD6C \uB3C4\uB2EC"
    stages:
    - {fileID: 11400000, guid: 6b1be001ba878b6438624137657e3f1f, type: 2}
  - id: cave_expedition
    code: G-05
    title: "\uACE0\uC704\uD5D8 \uC218\uC0C9"
    destinationId: cave
    destinationName: "\uC2EC\uC5F0\uC758 \uC218\uC815 \uB3D9\uAD74"
    briefing: "\uBC29\uC5B4 \uAC15\uD654\uC640 \uC0AC\uB9DD \uD6C4 \uC704\uD5D8 \uBC18\uC751\uC774
      \uB3D9\uC2DC\uC5D0 \uAC10\uC9C0\uB3FC. \uCDA9\uBD84\uD788 \uC900\uBE44\uD558\uACE0
      \uC9C4\uC785\uD574."
    difficulty: 3
    difficultyName: "\uC5B4\uB824\uC6C0"
    healthMultiplier: 1.5
    enemyGimmicks: 3
    gimmickName: "\uAC15\uD654 \uC7A5\uAC11 + \uC0AC\uB9DD \uD3ED\uBC1C"
    gimmickDescription: "\uC801\uC774 \uBC1B\uB294 \uD53C\uD574 25% \uAC10\uC18C(\uBC18\uC62C\uB9BC,
      \uCD5C\uC18C 1). \uCC98\uCE58 \uD6C4 1.25\uCD08 \uC608\uACE0 \uB4A4 \uBC18\uACBD
      3m\uC5D0 \uD53C\uD574 14. \uD3ED\uBC1C\uC740 \uD68C\uD53C \uAC00\uB2A5."
    objective: "\uBAA8\uB4E0 \uC804\uD22C\uBC29 \uC815\uB9AC \xB7 \uCD9C\uAD6C \uB3C4\uB2EC"
    stages:
    - {fileID: 11400000, guid: 4f36d5da9619297469eb82c844b552cb, type: 2}
  - id: game_exhibition
    code: G-06
    title: "\uBA48\uCD94\uC9C0 \uC54A\uB294 \uAC8C\uC784"
    destinationId: game
    destinationName: "\uAC8C\uC784\uC758 \uC794\uC0C1"
    briefing: "\uB20C\uB9B0 \uCE78\uC740 \uAE38\uC774 \uB418\uACE0, \uB2EB\uD78C
      \uCE78\uC740 \uBCBD\uC774 \uB41C\uB2E4. \uAC70\uB300\uD55C \uBE14\uB85D\uACFC
      \uAC8C\uC784 \uAE30\uAE30 \uC0AC\uC774\uB97C \uD1B5\uACFC\uD558\uB77C."
    difficulty: 2
    difficultyName: "\uBCF4\uD1B5"
    healthMultiplier: 1
    enemyGimmicks: 0
    gimmickName: "\uBCF5\uC140 \uAD70\uB2E8 \xB7 \uB4DC\uB86D \uD0A4\uD37C"
    gimmickDescription: "\uAC00\uC18D\uD558\uB294 \uBE14\uB85D \uD0C4\uB9C9 \xB7
      \uB124 \uBC88 \uD295\uAE30\uB294 I\uC790 \uBE14\uB85D \xB7 Z\uC790 \uBE14\uB85D
      \uC138 \uB9C8\uB9AC\uC758 \uB3CC\uC9C4. \uBC14\uB2E5 \uC608\uACE0\uB97C \uBCF4\uACE0
      \uD53C\uD558\uB77C."
    objective: "\uC138 \uC804\uD22C \uAD6C\uC5ED \uB3CC\uD30C \xB7 \uB4DC\uB86D \uD0A4\uD37C
      \uACA9\uD30C \xB7 \uCD9C\uAD6C \uB3C4\uB2EC"
    stages:
    - {fileID: 11400000, guid: 6718179d0ab1f284a8066f58bac55709, type: 2}
